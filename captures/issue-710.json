   "isObject": null,
   "mapID": 1453,
   "name": "Donyal Tovald",
   "npc": "2504",
   "questID": 97234,
   "race": "High Order Skyborne",
   "sex": "f",
   "source": "community",
   "text": "Let's see here. Roy's Book Club, isn't it? I recognize this wrap technique. \r\n\r\nWell, if he says this is what people want to talk about, it's all fine by me. The material we receive back is always in as good of quality as we loaned it, so we know they're treating it with respect regardless of how provoking the words may be.",
   "time": 1791028217,
   "title": "Reading Room",
   "wanted": true,
   "zone": "Stormwind City"
  },
  "97234-progress": {
   "build": "70205",
   "class": "Mage",
   "differs": null,
   "event": "progress",
   "isObject": null,
   "mapID": 1453,
   "name": "Donyal Tovald",
   "npc": "2504",
   "questID": 97234,
   "race": "High Order Skyborne",
   "sex": "f",
   "source": "community",
   "text": "Please keep your voice down.",
   "time": 1791028215,
   "title": "Reading Room",
   "wanted": null,
   "zone": "Stormwind City"
  },
  "97237-accept": {
   "build": "70205",
   "class": "Mage",
   "differs": null,
   "event": "accept",
   "isObject": null,
   "mapID": 1453,
   "name": "Donyal Tovald",
   "npc": "2504",
   "questID": 97237,
   "race": "High Order Skyborne",
   "sex": "f",
   "source": "community",
   "text": "I've checked our inventory and all of the selections Mr. Lewells has listed are currently available.\r\n\r\nYou will, however, need to procure them off the shelves yourself. Part of our librarian duty is vigilance, and for that, I will resume supervisory bookkeeping.\r\n\r\nReturning with the material to Roy on his behalf will not mark yourself accountable for their return; as with his note you're serving as the book club's official courier. Their establishment shall carry that burden.\r\n\r\nGood day, $N.",
   "time": 1791028222,
   "title": "Shelf Picked",
   "wanted": true,
   "zone": "Stormwind City"
  },
  "97237-complete": {
   "build": "70205",
   "class": "Mage",
   "differs": null,
   "event": "complete",
   "isObject": null,
   "mapID": 1453,
   "name": "Roy Lewells",
   "npc": "268568",
   "questID": 97237,
   "race": "High Order Skyborne",
   "sex": "f",
   "source": "community",
   "text": "These are them! Some of them even smell exotic! Fantastic, I can't wait for us to have lively conversations about these writings.\r\n\r\nCellar after hours, of course.\r\n\r\nThanks for the quick errand run, $N. As promised, it's on the house. We keep our word here.",
   "time": 1791029141,
   "title": "Shelf Picked",
   "wanted": true,
   "zone": "Stormwind City"
  },
