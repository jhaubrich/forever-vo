   "isObject": null,
   "mapID": 1454,
   "name": "Rashona Straglash",
   "npc": "14726",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "In these trying times, a simple donation of cloth can go a long way to help those less fortunate than ourselves.  Cloth goes a long way to making garments and bandages - both important for the war effort!\n\nIf you are interested in donating cloth pieces to the orcs of Orgrimmar, I will gladly accept them and make sure you receive the proper recognition for doing so.\n\nFor the Horde!",
   "time": 1791342098,
   "title": null,
   "wanted": null,
   "zone": "Orgrimmar"
  },
