  },
  "6740|c3a29bdb": {
   "build": "70245",
   "class": "Warlock",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1453,
   "name": "Innkeeper Allison",
   "npc": "6740",
   "questID": null,
   "race": "Human",
   "sex": "m",
   "source": "community",
   "text": "Our ancient lands are in the northeast of the Eastern Kingdom. Named after Lordain himself, it was once a proud and powerful kingdom. Its history is rich and offers many lessons to upstart nobles and kings. One of its defining moments was assisting in the foundation of the Alliance that we know today.\r\n\r\nUnfortunately, its history is also dark, and its current inhabitants defile its lands day by day. There is still much of significance in the ruins that now rest above the Undercity, but it is folly to attempt that journey and expect to return still among the living.",
   "time": 1791345336,
   "title": null,
   "wanted": null,
   "zone": "Stormwind City"
  }
