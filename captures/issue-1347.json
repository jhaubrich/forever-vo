  "266484|e94c420f": {
   "build": "70245",
   "class": "Paladin",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Morbin Lightbane",
   "npc": "266484",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "We paladins must earn our place amongst our Forsaken kin each day, lest we be judged as fanatics like the Scarlet Crusade. The light is not simply a tool of our foes, but a conduit for our righteous fury! It is in our devotion to the Dark Lady and the love of our home that we may channel the light to bring justice to our enemies.\r\n\r\nThe Banshee Queen keeps a close eye on us. Let her. She will see that our resolve shall never waver. We are Forsaken!",
   "time": 1791434059,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "272526|bf500b92": {
   "build": "70245",
   "class": "Paladin",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Glix Xizzix",
   "npc": "272526",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Yes, I am the renowned trader who magnanimously fed the uh, starving... children...? ...of the Undercity during the recent war with the Scourge. Yes, I am the visionary businessgob and logistical genius who single-handedly armed the resistance and allowed our Dark Lady to found her nation of smelly corpses... um, I mean, \"Forsaken.\"\r\n\r\nYep, I'm him. Glix Xizzix. I'd be happy to sign an autograph. For a small fee, of course.\r\n\r\nWhat am I doing here running a barbershop, you ask? Well I got one word for you, bub--diversification. You've got to keep your revenue streams diversified!",
   "time": 1791347433,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
