  },
  "94441-accept": {
   "build": "70245",
   "class": "Paladin",
   "differs": null,
   "event": "accept",
   "isObject": null,
   "mapID": 1420,
   "name": "Deathguard Billmuth",
   "npc": "257655",
   "questID": 94441,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Please give my thanks to Danitha Morr and tell her that the rest of the Deathguard will hear about the service that the paladins of Tyr's Watch performed for us. \r\n\r\nYou have a lot of promise as a $c, and I am proud to have those like you among the ranks of the Forsaken. Dark Lady watch over you, $N.",
   "time": 1791346421,
   "title": "A Lesson in Divinity",
   "wanted": true,
   "zone": "Tirisfal Glades"
  },
  "94441-complete": {
   "build": "70245",
   "class": "Paladin",
   "differs": null,
   "event": "complete",
   "isObject": null,
   "mapID": 1420,
   "name": "Danitha Morr",
   "npc": "246378",
   "questID": 94441,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "The Symbol of Life is only able to be used by a $c who is ready to make use of one of the light's greatest blessings. I'm proud to count you among us, and I now bestow upon you the gift of redemption. With this you will be able to resurrect your fallen companions. Use this new boon wisely.\r\n\r\nYou have done well for both the Forsaken as well as the paladins of Tyr's Watch. Any steps we can take to win the hearts and minds of our fellow Forsaken is well worth the effort. Go with the light, $N.",
   "time": 1791346445,
   "title": "A Lesson in Divinity",
   "wanted": true,
   "zone": "Tirisfal Glades"
  },
