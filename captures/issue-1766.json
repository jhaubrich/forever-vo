 "quests": {
  "97960-accept": {
   "build": "70338",
   "class": "Паладин",
   "differs": null,
   "event": "accept",
   "isObject": null,
   "mapID": 1420,
   "name": "Элеанор Шеклтон",
   "npc": "265812",
   "questID": 97960,
   "race": "Нежить",
   "sex": "f",
   "source": "community",
   "text": "Умение быстро снимать с убитых зверей кожи и шкуры – один из наиболее полезных навыков для любого искателя приключений.\r\n\r\nСдается мне, я знаю кое-кого, кто может научить тебя создавать удобный стул для лагеря. Иногда очень важно, чтобы было где расслабиться, – а из шкур, которые ты добываешь, можно скроить очень удобное сиденье. Благодаря этому ты точно будешь в форме, когда придет время для следующей потасовки.",
   "time": 1791701951,
   "title": "Основы походной жизни: снятие шкур",
   "wanted": null,
   "zone": "Тирисфальские леса"
  }
 },
 "source": "community",
 "version": 2
}