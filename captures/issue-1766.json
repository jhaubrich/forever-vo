  },
  "1515|00001505": {
   "build": "70338",
   "class": "Паладин",
   "differs": null,
   "event": "greeting",
   "isObject": null,
   "mapID": 1420,
   "name": "Палач Зуганд",
   "npc": "1515",
   "questID": null,
   "race": "Нежить",
   "sex": "f",
   "source": "community",
   "text": "В наши земли вторгся Алый орден. Эти глупые фанатики не понимают, что истинные слуги Темной Госпожи позаботятся об их гибели.",
   "time": 1791704718,
   "title": null,
   "wanted": null,
   "zone": "Тирисфальские леса"
  },
  "1518|00001505": {
   "build": "70338",
   "class": "Паладин",
   "differs": null,
   "event": "greeting",
   "isObject": null,
   "mapID": 1420,
   "name": "Аптекарь Юхан",
   "npc": "1518",
   "questID": null,
   "race": "Нежить",
   "sex": "f",
   "source": "community",
   "text": "Темная Госпожа поставила перед нами новую задачу. Мы должны ее выполнить.",
   "time": 1791704700,
   "title": null,
   "wanted": null,
   "zone": "Тирисфальские леса"
  },
  "1652|00001505": {
   "build": "70338",
   "class": "Паладин",
   "differs": null,
