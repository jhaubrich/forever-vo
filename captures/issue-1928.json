   "isObject": null,
   "mapID": 1454,
   "name": "Thrall",
   "npc": "4949",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "It would be wise to explain to you the depths at which our enemies will go to to hide themselves under our noses.\n\nKnow this first and foremost: our enemy is the Shadow Council. No matter what task I give you, or who I ask you to act against, know that one simple fact.\n\nMany cults exist within the Council, but only to hide its actions against the foolish.\n\nGroups like the Burning Blade, the Argus Wake, and the Searing Blade are all tools of the Council. Consider them one and the same.",
   "time": 1791746622,
   "title": null,
   "wanted": null,
   "zone": "Orgrimmar"
  }
