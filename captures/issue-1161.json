   "class": "Paladin",
   "differs": null,
   "event": "complete",
   "isObject": null,
   "mapID": 1420,
   "name": "Danitha Morr",
   "npc": "246378",
   "questID": 94441,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "The Symbol of Life is only able to be used by a $c who is ready to make use of one of the light's greatest blessings. I'm proud to count you among us, and I now bestow upon you the gift of redemption. With this you will be able to resurrect your fallen companions. Use this new boon wisely.\r\n\r\nYou have done well for both the Forsaken as well as the paladins of Tyr's Watch. Any steps we can take to win the hearts and minds of our fellow Forsaken is well worth the effort. Go with the light, $N.",
   "time": 1791230695,
   "title": "A Lesson in Divinity",
   "wanted": true,
   "zone": "Tirisfal Glades"
  },
