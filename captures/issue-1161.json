   "text": "What news of Deathguard Falgan?",
   "time": 1791230655,
   "title": "A Lesson in Divinity",
   "wanted": null,
   "zone": "Tirisfal Glades"
  },
  "94441-accept": {
   "build": "70245",
   "class": "Paladin",
   "differs": null,
   "event": "accept",
   "isObject": null,
   "mapID": 1420,
   "name": "Deathguard Billmuth",
   "npc": "257655",
   "questID": 94441,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Please give my thanks to Danitha Morr and tell her that the rest of the Deathguard will hear about the service that the paladins of Tyr's Watch performed for us. \r\n\r\nYou have a lot of promise as a $c, and I am proud to have those like you among the ranks of the Forsaken. Dark Lady watch over you, $N.",
   "time": 1791230657,
   "title": "A Lesson in Divinity",
   "wanted": true,
   "zone": "Tirisfal Glades"
  },
  "94441-complete": {
