  "256388|13e9970d": {
   "build": "70235",
   "class": "Shaman",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1413,
   "name": "Jornah",
   "npc": "256388",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Greetings and well met, $N! Your arrival is timely, and we here at the Durotar Supply and Logistics company are always in need of new contractors.\r\n\r\nIf you are someone with a knack for gathering useful materials or the skills to craft something from scratch, you have a place here.\r\n\r\nPlease let me know if you have any questions.",
   "time": 1791301667,
   "title": null,
   "wanted": null,
   "zone": "The Barrens"
  },
  "2995|bfaf54b7": {
   "build": "70235",
   "class": "Shaman",
   "differs": null,
   "event": "gossip",
   "isObject": null,
