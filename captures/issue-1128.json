   "name": "Mak",
   "npc": "3008",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Cairne himself lives here, they say. Once I have finished crafting a fitting gift, I will seek him out. Perhaps he will have words of wisdom for me.",
