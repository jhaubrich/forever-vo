   "npc": "3004",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Aren't the patterns beautiful? Each one speaks with its own voice.",
   "time": 1791310769,
   "title": null,
   "wanted": null,
   "zone": "Thunder Bluff"
  },
  "3007|6f1fdfed": {
   "build": "70235",
   "class": "Shaman",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1456,
   "name": "Una",
   "npc": "3007",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "The needle is small, but the thread is strong, and the stitches are fine. Our pact with Thrall and the others will hold. The Horde will not be driven from these lands.",
   "time": 1791310797,
   "title": null,
   "wanted": null,
   "zone": "Thunder Bluff"
  },
  "3008|a1a91c02": {
