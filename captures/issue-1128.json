   "name": "Tal",
   "npc": "2995",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "When mounted on the back of a wind rider, one sees that its reputation for strength and speed is well earned.",
   "time": 1791305356,
   "title": null,
   "wanted": null,
   "zone": "Thunder Bluff"
  },
  "3004|3236d362": {
   "build": "70235",
   "class": "Shaman",
