   "npc": "3433",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "The Warchief has instructed me to study all kinds of weapons and armor. He has sent me here to the hub of both the tauren and orc cultures in the Barrens to meet as many travelers as possible, and to learn about the cultures of the Barrens.\n\nHe feels there's something to be learned from even the most pathetic of cultures... like the quilboar or centaur.",
   "time": 1791733353,
   "title": null,
   "wanted": null,
   "zone": "The Barrens"
  },
