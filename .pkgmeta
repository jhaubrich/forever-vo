# BigWigs packager config. The repository holds the addon in ForeverVO/ next to
# the voice pack and the tools; only ForeverVO ships from here (the pack is
# released separately because of its size).
package-as: forever-vo

move-folders:
  forever-vo/ForeverVO: ForeverVO

ignore:
  - ForeverVO_Data
  - tools
  - captures
  - docs
  - .github
  - .pkgmeta
  - .gitignore
  - README.md
  - CHANGELOG.md
  - CLAUDE.md
  - LICENSE
  - pyproject.toml
  - uv.lock
  - flake.nix
  - flake.lock
  - .python-version

enable-nolib-creation: no
manual-changelog: CHANGELOG.md
